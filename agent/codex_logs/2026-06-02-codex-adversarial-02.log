# ---------------- plane fitting (open-source pyransac3d) ----------------
def fit_planes_p3(pts, seed=0):
    try:
        import pyransac3d as p3
    except ImportError:  # self-bootstrap on a bare Colab (review: pyransac3d not in repo deps)
        import subprocess
